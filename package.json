{
  "name": "@onlydns/sdk",
  "version": "1.0.0",
  "description": "Official TypeScript/JavaScript SDK for OnlyDNS System API (onlydns.com)",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "node --test tests/*.test.js"
  },
  "keywords": [
    "onlydns",
    "dns",
    "sdk",
    "typescript",
    "ai-agents",
    "mcp",
    "networking"
  ],
  "author": "OnlyDNS <support@onlydns.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/onlydns/onlydns-sdk-typescript.git"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  }
}
