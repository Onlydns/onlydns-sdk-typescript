{
  "name": "@onlydns/sdk",
  "version": "1.0.5",
  "description": "Official TypeScript/JavaScript SDK for OnlyDNS System API (onlydns.com)",
  "author": "OnlyDNS <support@onlydns.com>",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "pretest": "npm run build",
    "test": "node --test tests/*.test.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "onlydns",
    "dns",
    "sdk",
    "typescript",
    "ai-agents",
    "mcp",
    "networking"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Onlydns/onlydns-sdk-typescript.git"
  },
  "bugs": {
    "url": "https://github.com/Onlydns/onlydns-sdk-typescript/issues"
  },
  "homepage": "https://github.com/Onlydns/onlydns-sdk-typescript#readme",
  "devDependencies": {
    "typescript": "^5.0.0"
  }
}
